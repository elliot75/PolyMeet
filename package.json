{
  "name": "polymeet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:client\" \"npm:dev:server\"",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "preview": "npm start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:client": "vite --host 127.0.0.1",
    "start": "node dist/server/index.js",
    "format": "prettier --write src tests public/audio-worklet.js vite.config.ts",
    "format:check": "prettier --check src tests public/audio-worklet.js vite.config.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@hono/node-server": "^2.1.11",
    "dompurify": "^3.4.18",
    "dotenv": "^18.0.10",
    "hono": "^4.9.0",
    "idb": "^8.0.4",
    "marked": "^18.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "openai": "^7.62.0",
    "opencc-js": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
