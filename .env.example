# Optional server-side fallback keys. Never commit the real .env file.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional SQLite database path (defaults to ./data/polymeet.sqlite).
# POLYMEET_DB_PATH=./data/polymeet.sqlite

# Optional initial admin account created on startup when the account database is empty.
# POLYMEET_ADMIN_USERNAME=admin
# POLYMEET_ADMIN_PASSWORD=

# Optional browser setup token. Set a random value with at least 32 characters.
# POLYMEET_SETUP_TOKEN=

# Session lifetime in hours (defaults to 168 / 7 days).
# POLYMEET_SESSION_TTL_HOURS=168

# Timezone used for daily billing grouping (e.g. Asia/Taipei).
# TZ=Asia/Taipei

# Optional host interface binding (defaults to 127.0.0.1; set to 0.0.0.0 when containerized).
# HOST=127.0.0.1

# Optional comma-separated HTTPS origins for LAN and Tailnet reverse proxies.
# POLYMEET_HTTPS_ORIGINS=https://192.168.1.10:8443,https://my-node.my-tailnet.ts.net
